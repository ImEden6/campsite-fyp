generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  firstName       String
  lastName        String
  phone           String?
  role            UserRole         @default(CUSTOMER)
  password        String
  isActive        Boolean          @default(true)
  isEmailVerified Boolean          @default(false)
  isPhoneVerified Boolean          @default(false)
  avatar          String?
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  avatarKey       String?
  apiKeys         ApiKey[]
  bookings        Booking[]
  communications  Communication[]
  notifications   Notification[]
  payments        Payment[]
  preferences     UserPreferences?
  sessions        UserSession[]

  @@map("users")
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("light")
  language           String   @default("en")
  timezone           String   @default("America/New_York")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  permissions Json      @default("[]")
  rateLimit   Int       @default(1000)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User      @relation(fields: [createdBy], references: [id])

  @@index([keyHash])
  @@index([createdBy])
  @@map("api_keys")
}

model Site {
  id             String     @id @default(cuid())
  name           String     @unique
  type           SiteType
  status         SiteStatus @default(AVAILABLE)
  capacity       Int
  description    String?
  amenities      String[]   @default([])
  images         String[]   @default([])
  basePrice      Float
  maxVehicles    Int        @default(2)
  maxTents       Int        @default(1)
  isPetFriendly  Boolean    @default(false)
  hasElectricity Boolean    @default(false)
  hasWater       Boolean    @default(false)
  hasSewer       Boolean    @default(false)
  hasWifi        Boolean    @default(false)
  sizeLength     Float
  sizeWidth      Float
  sizeUnit       String     @default("feet")
  latitude       Float
  longitude      Float
  mapPositionX   Float
  mapPositionY   Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  bookings       Booking[]

  @@index([type, status])
  @@map("sites")
}

model Booking {
  id                    String                 @id @default(cuid())
  bookingNumber         String                 @unique
  userId                String
  siteId                String
  checkInDate           DateTime
  checkOutDate          DateTime
  adultGuests           Int
  childGuests           Int
  petGuests             Int                    @default(0)
  status                BookingStatus          @default(PENDING)
  paymentStatus         PaymentStatus          @default(PENDING)
  totalAmount           Float
  paidAmount            Float                  @default(0)
  depositAmount         Float                  @default(0)
  taxAmount             Float                  @default(0)
  discountAmount        Float                  @default(0)
  notes                 String?
  specialRequests       String?
  checkInTime           DateTime?
  checkOutTime          DateTime?
  qrCode                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  site                  Site                   @relation(fields: [siteId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  communications        Communication[]
  equipmentRentals      EquipmentRental[]
  equipmentReservations EquipmentReservation[]
  guests                Guest[]
  payments              Payment[]
  vehicles              Vehicle[]

  @@index([userId])
  @@index([siteId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@index([createdAt])
  @@map("bookings")
}

model Guest {
  id        String    @id @default(cuid())
  bookingId String
  firstName String
  lastName  String
  email     String?
  phone     String?
  type      GuestType @default(ADULT)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("guests")
}

model Vehicle {
  id           String      @id @default(cuid())
  bookingId    String
  make         String
  model        String
  year         Int
  licensePlate String
  state        String
  color        String
  type         VehicleType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("vehicles")
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  userId          String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  stripeRefundId  String?
  transactionId   String?
  description     String?
  receiptUrl      String?
  processedAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([createdAt])
  @@map("payments")
}

model Equipment {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  category       EquipmentCategory
  quantity       Int                    @default(0)
  dailyRate      Float
  weeklyRate     Float
  monthlyRate    Float
  deposit        Float                  @default(0)
  images         String[]               @default([])
  specifications Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isSerialized   Boolean                @default(true)
  manufacturer   String?
  minStockLevel  Int                    @default(0)
  modelNumber    String?
  items          EquipmentItem[]
  reservations   EquipmentReservation[]

  @@map("equipment")
}

model EquipmentItem {
  id            String              @id @default(cuid())
  equipmentId   String
  internalId    String              @unique
  serialNumber  String?
  status        EquipmentItemStatus @default(AVAILABLE)
  condition     EquipmentCondition  @default(GOOD)
  purchaseDate  DateTime?
  purchasePrice Float?
  supplier      String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  equipment     Equipment           @relation(fields: [equipmentId], references: [id])
  rentals       EquipmentRental[]
  maintenance   MaintenanceLog[]

  @@map("equipment_items")
}

model EquipmentReservation {
  id          String            @id @default(cuid())
  bookingId   String
  equipmentId String
  quantity    Int
  startDate   DateTime
  endDate     DateTime
  status      ReservationStatus @default(CONFIRMED)
  dailyRate   Float
  totalAmount Float
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  rentals     EquipmentRental[]
  booking     Booking           @relation(fields: [bookingId], references: [id])
  equipment   Equipment         @relation(fields: [equipmentId], references: [id])

  @@index([bookingId])
  @@index([startDate, endDate])
  @@map("equipment_reservations")
}

model EquipmentRental {
  id              String               @id @default(cuid())
  bookingId       String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  checkoutTime    DateTime             @default(now())
  conditionIn     EquipmentCondition?
  conditionOut    EquipmentCondition?
  equipmentItemId String?
  receivedBy      String?
  rentedBy        String?
  reservationId   String
  returnTime      DateTime?
  booking         Booking?             @relation(fields: [bookingId], references: [id])
  item            EquipmentItem?       @relation(fields: [equipmentItemId], references: [id])
  reservation     EquipmentReservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([equipmentItemId])
  @@map("equipment_rentals")
}

model MaintenanceLog {
  id              String            @id @default(cuid())
  equipmentItemId String
  type            MaintenanceType
  status          MaintenanceStatus @default(SCHEDULED)
  description     String
  cost            Float?
  performedBy     String?
  scheduledDate   DateTime
  completedDate   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  item            EquipmentItem     @relation(fields: [equipmentItemId], references: [id])

  @@index([equipmentItemId])
  @@map("maintenance_logs")
}

model Communication {
  id        String            @id @default(cuid())
  bookingId String?
  userId    String?
  type      CommunicationType
  subject   String?
  message   String
  sentBy    String
  sentTo    String?
  sentAt    DateTime          @default(now())
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  booking   Booking?          @relation(fields: [bookingId], references: [id])
  user      User?             @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("communications")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PricingRule {
  id            String     @id @default(cuid())
  name          String
  description   String?
  siteTypes     SiteType[]
  startDate     DateTime
  endDate       DateTime
  daysOfWeek    Int[]      @default([])
  priceModifier Float
  modifierType  String     @default("multiplier")
  minStay       Int?
  maxStay       Int?
  priority      Int        @default(1)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("pricing_rules")
}

model GroupBooking {
  id             String             @id @default(cuid())
  name           String
  contactName    String
  contactEmail   String
  contactPhone   String
  expectedGuests Int
  expectedSites  Int
  eventDate      DateTime
  eventEndDate   DateTime?
  specialRate    Float?
  notes          String?
  status         GroupBookingStatus @default(INQUIRY)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("group_bookings")
}

model CampsiteSettings {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  addressStreet      String
  addressCity        String
  addressState       String
  addressZip         String
  addressCountry     String
  contactPhone       String
  contactEmail       String
  contactWebsite     String?
  checkInTime        String
  checkOutTime       String
  quietHoursStart    String
  quietHoursEnd      String
  petPolicy          String
  cancellationPolicy String
  refundPolicy       String
  hasPool            Boolean  @default(false)
  hasPlayground      Boolean  @default(false)
  hasRestrooms       Boolean  @default(true)
  hasShowers         Boolean  @default(true)
  hasLaundry         Boolean  @default(false)
  hasStore           Boolean  @default(false)
  hasWifi            Boolean  @default(false)
  allowsPets         Boolean  @default(false)
  allowsFires        Boolean  @default(false)
  timezone           String   @default("America/New_York")
  currency           String   @default("USD")
  taxRate            Float    @default(0.08)
  depositPercentage  Float    @default(25.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("campsite_settings")
}

model FileUpload {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  metadata     Json?

  @@map("file_uploads")
}

model WeatherData {
  id            String            @id @default(cuid())
  temperature   Float
  humidity      Float
  windSpeed     Float
  windDirection String
  condition     String
  icon          String
  updatedAt     DateTime          @updatedAt
  forecast      WeatherForecast[]

  @@map("weather_data")
}

model WeatherForecast {
  id            String      @id @default(cuid())
  weatherDataId String
  date          DateTime
  high          Float
  low           Float
  condition     String
  icon          String
  precipitation Float
  weatherData   WeatherData @relation(fields: [weatherDataId], references: [id], onDelete: Cascade)

  @@map("weather_forecasts")
}

model CalendarEvent {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime
  allDay             Boolean   @default(false)
  location           String?
  attendees          String[]  @default([])
  recurrenceFreq     String?
  recurrenceInterval Int?
  recurrenceUntil    DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("calendar_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum SiteType {
  TENT
  RV
  CABIN
}

enum SiteStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHECK
  BANK_TRANSFER
}

enum VehicleType {
  CAR
  TRUCK
  RV
  MOTORCYCLE
  TRAILER
}

enum EquipmentCategory {
  CAMPING_GEAR
  RECREATIONAL
  KITCHEN
  SAFETY
  MAINTENANCE
  WATER_SPORTS
  WINTER_SPORTS
  ELECTRONICS
  COMFORT
}

enum EquipmentItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  REPAIR
  LOST
  RETIRED
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  FULFILLED
  PARTIAL
}

enum MaintenanceType {
  INSPECTION
  CLEANING
  REPAIR
  ROUTINE_SERVICE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationType {
  EMAIL
  SMS
  PHONE
  NOTE
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  PAYMENT_CONFIRMATION
  PAYMENT_FAILED
  CHECK_IN_REMINDER
  CHECK_OUT_REMINDER
  CANCELLATION
  SYSTEM_ALERT
}

enum GroupBookingStatus {
  INQUIRY
  QUOTED
  CONFIRMED
  CANCELLED
}

enum GuestType {
  ADULT
  CHILD
}
