{
  "name": "@campsite-management/backend",
  "version": "1.0.0",
  "description": "Backend API for campsite management system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run db:generate && nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run --include '**/*.unit.test.ts'",
    "test:int": "vitest run --include '**/*.int.test.ts' --testTimeout=30000",
    "test:ci": "vitest run --reporter=junit --outputFile=./test-results/junit.xml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@campsite-management/shared": "1.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.23.0",
    "@sentry/profiling-node": "^10.23.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "sharp": "^0.33.1",
    "socket.io": "^4.7.4",
    "stripe": "^14.9.0",
    "twilio": "^4.23.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/config": "^7.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^2.0.16",
    "@types/twilio": "^3.19.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "^9.39.2",
    "nodemon": "^3.0.2",
    "prisma": "^7.0.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
