{
  "name": "campsite-management-system",
  "version": "1.0.0",
  "description": "Campsite Management System",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w @campsite-management/frontend",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @campsite-management/frontend",
    "preview:local": "npm run preview:local -w @campsite-management/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:frontend": "npm run lint -w @campsite-management/frontend",
    "lint:backend": "npm run lint -w @campsite-management/backend",
    "type-check": "npm run type-check --workspaces --if-present",
    "type-check:frontend": "npm run type-check -w @campsite-management/frontend",
    "type-check:backend": "npm run type-check -w @campsite-management/backend",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @campsite-management/backend",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "workspaces": [
    "frontend",
    "shared",
    "backend",
    "tests"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-reconciler": "0.29.0",
    "react-dropzone": {
      "react": "18.3.1"
    },
    "@sentry/react": {
      "react": "18.3.1"
    },
    "zustand": {
      "react": "18.3.1"
    }
  },
  "keywords": [
    "campsite",
    "management",
    "booking",
    "reservation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@campsite-management/frontend": "^1.0.0",
    "@campsite-management/shared": "^1.0.0"
  }
}